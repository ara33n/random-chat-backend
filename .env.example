MONGO_URI=mongodb://127.0.0.1:27017/chatapp
PORT=3001
# Configure administrator credentials in your hosting environment. No defaults exist.
ADMIN_USER=
ADMIN_PASS=
ADMIN_TOKEN=
# Set only behind a trusted proxy. Render is detected automatically.
TRUST_PROXY=false

# Paddle: use sandbox values first; never expose API key or webhook secret in frontend.
PADDLE_ENVIRONMENT=sandbox
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_UNBAN_PRICE_ID=
