MONGO_URI=mongodb://127.0.0.1:27017/chatapp
PORT=3001
# Configure administrator credentials in your hosting environment. No defaults exist.
ADMIN_USER=
ADMIN_PASS=
ADMIN_TOKEN=
# Set only behind a trusted proxy. Render is detected automatically.
TRUST_PROXY=false

# Paddle backend. All four values are required together; there is no environment fallback.
# Local/development example:
PADDLE_ENVIRONMENT=sandbox
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_UNBAN_PRICE_ID=

# Production/Render uses Live values under the same variable names:
# PADDLE_ENVIRONMENT=production
# PADDLE_API_KEY=replace_with_live_server_api_key
# PADDLE_WEBHOOK_SECRET=replace_with_live_notification_destination_secret
# PADDLE_UNBAN_PRICE_ID=pri_replace_with_live_one_time_price_id
